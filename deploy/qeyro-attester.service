[Unit]
Description=QEYRO FI attester (read-only watcher)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qeyro
Group=qeyro
WorkingDirectory=/opt/qeyro-fi-attester
EnvironmentFile=/etc/qeyro-attester.env
ExecStart=/usr/bin/node dist/cli.js watch --json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
